{
  "name": "DayZ Console Observatory",
  "version": "0.8.0",
  "repository": "chrishotza/DayZConsoleObservatory",
  "entrypoints": {
    "windows": "START_HERE.cmd",
    "desktop": "launcher.py",
    "cli": "src/dayz_observatory/cli.py",
    "ai": "AGENTS.md",
    "documentation": "docs/INDEX.md",
    "browser": "src/dayz_observatory/web/index.html"
  },
  "runtime": "Python >=3.10; standard library for local app",
  "capabilities": {
    "browser_gui": "offline-tested; browser upload and isolated synthetic demo",
    "adm_sqlite": "offline-tested",
    "historical_positions": "sparse X/Z snapshots",
    "incident_review": "offline-tested",
    "nitrado_live": "UNVERIFIED",
    "esp_teleport_invisibility": "NOT IMPLEMENTED",
    "accessible_positions": "Historical X/Z positions also available in a keyboard-accessible text table."
  },
  "modules": {
    "frontend": [
      "src/dayz_observatory/web/index.html",
      "src/dayz_observatory/web/app.js",
      "src/dayz_observatory/web/style.css"
    ],
    "http": [
      "src/dayz_observatory/server.py",
      "tests/test_browser_import.py",
      "tests/test_http.py"
    ],
    "launcher": [
      "launcher.py",
      "START_HERE.cmd",
      "tests/test_launcher.py"
    ],
    "parse": [
      "src/dayz_observatory/parser.py",
      "src/dayz_observatory/store.py"
    ],
    "evidence": [
      "src/dayz_observatory/investigate.py",
      "src/dayz_observatory/incidents.py",
      "src/dayz_observatory/casebook.py"
    ],
    "provider": [
      "src/dayz_observatory/nitrado.py",
      "src/dayz_observatory/sync.py",
      "src/dayz_observatory/watch.py"
    ],
    "maintenance": [
      "src/dayz_observatory/maintenance.py"
    ],
    "tests": [
      "tests/"
    ]
  },
  "validation": {
    "offline": "python -m unittest discover -s tests -v",
    "launcher": "python launcher.py --check",
    "real_server": "not performed",
    "github_actions": [
      "ubuntu Python 3.10",
      "ubuntu Python 3.12",
      "ubuntu Python 3.13",
      "ubuntu Python 3.14",
      "windows Python 3.12",
      "windows Python 3.14",
      "macos Python 3.12",
      "macos Python 3.14"
    ]
  },
  "data_policy": "No public tokens, raw player logs, coordinates, IDs or SQLite database files; localhost not authenticated for network exposure."
}
